# DS2API runtime
# Runtime listen port inside the app/container
PORT=5001
# Docker Compose host port (compose only; container still listens on PORT)
DS2API_HOST_PORT=6011
LOG_LEVEL=INFO

# Admin authentication
DS2API_ADMIN_KEY=change-me

# Config loading (choose one)
# 1) file-based config
DS2API_CONFIG_PATH=/app/config.json
# 2) inline JSON or Base64 JSON
# DS2API_CONFIG_JSON=
# 3) legacy compatibility alias
# CONFIG_JSON=

# Direct DeepSeek tokens (optional, convenience)
# Paste one or more DeepSeek session tokens to use them directly as the
# upstream credential, with no email/password login. Comma- or newline-
# separated. These are merged in on top of whatever the config source above
# provides, and de-duplicated. Use DS2API_TOKEN for a single token.
# DS2API_TOKENS=token-aaa,token-bbb
# DS2API_TOKEN=single-token

# Optional: static admin assets path
# DS2API_STATIC_ADMIN_DIR=/app/static/admin


# ---------- Anti risk-control tuning (optional) ----------
# Per-call jitter range applied to login / create_session / get_pow /
# completion. Distribution is log-uniform, so most calls stay near the
# lower bound. Set both to 0 to disable. Defaults: 80–350ms.
# DS2API_REQUEST_JITTER_MIN_MS=80
# DS2API_REQUEST_JITTER_MAX_MS=350

# Fixed salt used to derive each account's stable browser fingerprint
# (User-Agent, sec-ch-ua, locale, cookie jar). Leave empty for a per-process
# random salt. Set this to keep fingerprints stable across restarts, or change
# it (or hit POST /admin/queue/rotate-fingerprints) to rotate browser
# identities for the whole fleet.
# DS2API_FINGERPRINT_SALT=

# DeepSeek session cache TTL (minutes). The same chat_session_id is reused
# for a given account within this window so we don't open a new session per
# request. Set to 0 to disable. Default: 10.
# DS2API_SESSION_CACHE_TTL_MINUTES=10
